# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=gp-rag-docs

# ─── Upstash Redis ────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:your_redis_password@your-host.upstash.io:6379

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# IMPORTANT: key must be MONGO_URI (matches what the code reads)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gp_rag?retryWrites=true&w=majority

# ─── FastAPI ──────────────────────────────────────────────────────────────────
PORT=8000
# Comma-separated list of allowed frontend origins (no wildcard with credentials)
ALLOWED_ORIGINS=http://localhost:3000
