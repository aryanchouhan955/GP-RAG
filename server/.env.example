# ========================
# Google Gemini (free)
# Get key at: https://aistudio.google.com/app/apikey
# ========================
GEMINI_API_KEY=your-gemini-api-key-here

# ========================
# Qdrant Vector Database
# Get free cluster at: https://cloud.qdrant.io
# ========================
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ========================
# Upstash Redis (BullMQ)
# Get free DB at: https://upstash.com
# Copy the "TCP" REDIS_URL from your Upstash dashboard
# rediss:// = Redis with TLS (required by Upstash)
# ========================
REDIS_URL=rediss://default:your-password@your-db.upstash.io:6379

# ========================
# Server
# ========================
PORT=8000
